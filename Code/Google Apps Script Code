function doPost(e) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheets()[0];
  
  var incomingData;
  try {
    incomingData = JSON.parse(e.postData.contents);
  } catch (error) {
    return ContentService.createTextOutput("Error: Invalid JSON payload.");
  }

  // Handle both a single array ["2026-10-27", 0, 5, 7, 3, 4] 
  // and an array of arrays [["2026-10-27", ...], ["2026-10-28", ...]]
  var votesList = [];
  if (Array.isArray(incomingData)) {
    if (Array.isArray(incomingData[0])) {
      votesList = incomingData; // It's already a list of multiple dates
    } else {
      votesList = [incomingData]; // It's a single date, wrap it in an array
    }
  } else {
    return ContentService.createTextOutput("Error: Expected an array payload.");
  }

  if (votesList.length === 0) {
    return ContentService.createTextOutput("Success: No votes to process.");
  }

  // --- Configuration ---
  var startRow = 2; 
  var lastRow = sheet.getLastRow();
  
  if (lastRow < startRow) {
    return ContentService.createTextOutput("Error: No data rows found in the sheet.");
  }

  // --- Batch Fetch Data ---
  // Read dates (Column B)
  var timestampRange = sheet.getRange(startRow, 2, lastRow - startRow + 1, 1);
  var timestampValues = timestampRange.getValues();

  // Read current vote counts (Columns C through G)
  var votesRange = sheet.getRange(startRow, 3, lastRow - startRow + 1, 5);
  var votesValues = votesRange.getValues();

  var isDataUpdated = false;

  // --- Process Incoming Arrays in Memory ---
  votesList.forEach(function(record) {
    // Ensure the array has the expected 6 elements [Date, Hate, Dislike, Neutral, Like, Love]
    if (record.length < 6) {
      Logger.log("Skipping invalid record length: " + record);
      return; 
    }

    var incomingDate = String(record[0]).trim();
    var incomingHate = parseInt(record[1]) || 0;
    var incomingDislike = parseInt(record[2]) || 0;
    var incomingNeutral = parseInt(record[3]) || 0;
    var incomingLike = parseInt(record[4]) || 0;
    var incomingLove = parseInt(record[5]) || 0;

    // Search for the matching date in the fetched array
    for (var i = 0; i < timestampValues.length; i++) {
      var sheetDateVal = timestampValues[i][0];
      var sheetDateString = "";

      // Safely convert Google Sheets Date objects to YYYY-MM-DD strings
      if (sheetDateVal instanceof Date) {
        sheetDateString = Utilities.formatDate(sheetDateVal, ss.getSpreadsheetTimeZone(), "yyyy-MM-dd");
      } else {
        sheetDateString = String(sheetDateVal).trim();
      }

      if (sheetDateString === incomingDate) {
        // Add the incoming votes to the existing tallies in memory
        votesValues[i][0] = (parseInt(votesValues[i][0]) || 0) + incomingHate;    // Column C
        votesValues[i][1] = (parseInt(votesValues[i][1]) || 0) + incomingDislike; // Column D
        votesValues[i][2] = (parseInt(votesValues[i][2]) || 0) + incomingNeutral; // Column E
        votesValues[i][3] = (parseInt(votesValues[i][3]) || 0) + incomingLike;    // Column F
        votesValues[i][4] = (parseInt(votesValues[i][4]) || 0) + incomingLove;    // Column G
        
        isDataUpdated = true;
        break; // Stop searching once the matching date is found
      }
    }
  });

  // --- Batch Write Data ---
  if (isDataUpdated) {
    votesRange.setValues(votesValues);
    return ContentService.createTextOutput("Success: Vote arrays processed and added to sheet.");
  } else {
    return ContentService.createTextOutput("Success: Payload received, but no matching dates were found.");
  }
}

function doGet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheets()[0];
  
  // --- CONFIGURATION ---
  // This format MUST match the plain text in your sheet exactly.
  // Examples: "yyyy-MM-dd", "MM/dd/yyyy", "dd/MM/yyyy"
  const dateFormat = "yyyy-MM-dd"; 
  const timeZone = ss.getSpreadsheetTimeZone();
  
  // Generate "Today" as a string in that specific format
  const todayStr = Utilities.formatDate(new Date(), timeZone, dateFormat);
  
  // --- LOGIC ---
  // 1. Get all text from Column B
  // Since it's plain text, getValues() returns strings, not Date objects.
  const colBValues = sheet.getRange("B:B").getValues();
  
  let targetRow = 0;
  
  // 2. Loop to find the match
  for (let i = 0; i < colBValues.length; i++) {
    // Compare string to string. 
    // We use String() and trim() to remove accidental spaces and ensure type safety.
    if (String(colBValues[i][0]).trim() === todayStr) {
      targetRow = i + 1; // Found the row (1-indexed)
      break; 
    }
  }

  // 3. If no match found
  if (targetRow === 0) {
    return ContentService.createTextOutput(JSON.stringify({
      "status": "error", "message": "No row found for date: " + todayStr
    })).setMimeType(ContentService.MimeType.JSON);
  }

  // 4. Return Data (Columns A-G)
  // We use getDisplayValues() to ensure the microcontroller gets exactly what you see
  const rowData = sheet.getRange(targetRow, 1, 1, 7).getDisplayValues()[0];

  const result = {
    "row": targetRow,
    "data": rowData
  };

  return ContentService.createTextOutput(JSON.stringify(result))
    .setMimeType(ContentService.MimeType.JSON);
}

function updateChart() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheets()[0];
  
  // --- 1. Find the last row with data in Cols C-G ---
  const lastRow = sheet.getLastRow();
  const rawData = sheet.getRange(2, 3, lastRow - 1, 5).getValues();
  Logger.log(lastRow);
  let trueLastRow = 0;
  for (let i = rawData.length - 1; i >= 0; i--) {
    if (rawData[i].some(cell => cell !== "" && cell !== null)) {
      trueLastRow = i + 2; 
      break;
    }
  }
  if (trueLastRow === 0) return;

  Logger.log(trueLastRow);
  // --- 2. Define the Window (Last 5 Rows) ---
  const numRowsToDisplay = 5;
  const startRow = Math.max(2, trueLastRow - numRowsToDisplay + 1);
  const rowsToGrab = (trueLastRow - startRow + 1);

  // --- 3. Clear Old Charts ---
  const charts = sheet.getCharts();
  for (let i = 0; i < charts.length; i++) {
    sheet.removeChart(charts[i]);
  }

  // --- 4. Get Headers from Row 1 (Columns C-G) ---
  // We read the 1st row, columns 3 to 7 (C, D, E, F, G)
  const headers = sheet.getRange(1, 3, 1, 6).getValues()[0];

  // --- 5. Build Series Options ---
  // We create an object that tells the chart: "Series 0 is named 'Temp', Series 1 is 'Humidity'..."
  const seriesOptions = {};
  for (let i = 0; i < headers.length-1; i++) {
    seriesOptions[i] = 
    { labelInLegend: headers[i]}  

  }

  // --- 6. Define Ranges ---
  const labelRange = sheet.getRange(startRow, 1, rowsToGrab, 1); // Col A (X-Axis)
  const dataRange = sheet.getRange(startRow, 3, rowsToGrab, 5);  // Col C-G (Data)

  // --- 7. Build the Bar Chart ---
  const chart = sheet.newChart()
    .setChartType(Charts.ChartType.BAR) // Flips columns to horizontal bars
    .addRange(labelRange)
    .addRange(dataRange)
    .setPosition(2, 9, 0, 0)
    .setOption('width', 500)   // Set width in pixels (default is ~600)
    .setOption('height', 380)  // Set height in pixels (default is ~371)
    .setOption('title', 'Number of votes (Last 5 Entries)')
    // Move Legend to the Left
    .setOption('legend', { position: 'bottom' })    
    // Apply our custom headers here
    .setOption('series', seriesOptions) 

    // Remove category gaps & expand plot area width so bars render thicker
    .setOption('bar', { groupWidth: '100%' })
    .setOption('chartArea', {
      top: '10%',
      height: '75%',    // Leaving 30% space at the bottom for X-axis labels
      width: '55%',      // Leaving space on the right for legend
      left: '35%'
    })
    .build();

  sheet.insertChart(chart);
    // Option 1: 100% Stacked Column Chart (Best for multi-column data C-G)
  const chartper = sheet.newChart()
    .setChartType(Charts.ChartType.BAR) // Flips columns to horizontal bars
    .addRange(labelRange)
    .addRange(dataRange)
    .setPosition(19, 9, 0, 0) // Places chart at Column I
    .setOption('width', 500)   // Set width in pixels (default is ~600)
    .setOption('height', 380)  // Set height in pixels (default is ~371)
    .setOption('title', '% of votes (Last 5 Entries)')
        // Move Legend to the Left
    .setOption('legend', { position: 'bottom' })  
    .setOption('isStacked', 'percent') // Converts absolute values into 100% percentages
    // Apply our custom headers here
    .setOption('series', seriesOptions) 
    // --- EXPAND X-AXIS LABEL SPACE ---

    .setOption('chartArea', {
      top: '10%',       // Distance from chart top
      height: '75%',    // Leaving 30% space at the bottom for X-axis labels
      width: '55%',      // Leaving space on the right for legend
      left: '35%'
    })
    .build();

  sheet.insertChart(chartper);

}
